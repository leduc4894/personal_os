[importlinter]
root_packages =
    personal_os
    api_runtime
    mcp_runtime
    workflow_worker
    r2_object_storage
    postgresql_source_store
include_external_packages = True

[importlinter:contract:domain-does-not-import-composition-or-infrastructure]
name = Core package does not import composition roots or infrastructure SDKs
type = forbidden
source_modules =
    personal_os
forbidden_modules =
    api_runtime
    mcp_runtime
    workflow_worker
    fastapi
    sqlalchemy
    temporalio
    mcp
    qdrant_client
    neo4j
    redis
    boto3
    aiobotocore
    botocore
    aiohttp
    r2_object_storage
    postgresql_source_store

[importlinter:contract:composition-roots-are-independent]
name = Python composition roots do not import one another
type = independence
modules =
    api_runtime
    mcp_runtime
    workflow_worker

[importlinter:contract:r2-adapter-does-not-import-composition-or-infrastructure]
name = R2 object-storage adapter imports only core contracts and its approved SDK graph
type = forbidden
source_modules =
    r2_object_storage
forbidden_modules =
    api_runtime
    mcp_runtime
    workflow_worker
    fastapi
    sqlalchemy
    psycopg
    temporalio
    qdrant_client
    neo4j
    redis

[importlinter:contract:postgresql-adapter-does-not-import-composition-or-infrastructure]
name = PostgreSQL source-store adapter imports only core contracts and its approved SQL SDK graph
type = forbidden
source_modules =
    postgresql_source_store
forbidden_modules =
    api_runtime
    mcp_runtime
    workflow_worker
    r2_object_storage
    temporalio
    qdrant_client
    neo4j
    redis

[importlinter:contract:temporal-sdk-imports-only-from-worker]
name = Temporal SDK is imported only by the workflow worker composition root
type = forbidden
source_modules =
    api_runtime
    mcp_runtime
    personal_os
    r2_object_storage
    postgresql_source_store
forbidden_modules =
    temporalio
