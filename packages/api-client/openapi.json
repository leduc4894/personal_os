      "ApiErrorBody": {
        "additionalProperties": false,
        "description": "The failure body: registry code, safe message, retryability and details.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "details": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ApiDetailValue"
            },
            "title": "Details",
            "type": "object"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "retryable",
          "details"
        ],
        "title": "ApiErrorBody",
        "type": "object"
      },
      "ApiWarning": {
        "additionalProperties": false,
        "description": "One non-fatal advisory attached to a response.\n\nThe schema is fixed now for contract stability; this child registers no\nwarning vocabulary and every route returns an empty warning list. Later\nchildren must register public warning codes before using them.",
        "properties": {
          "code": {
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,63}$",
            "title": "Code",
            "type": "string"
          },
          "details": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ApiDetailValue"
            },
            "title": "Details",
            "type": "object"
          },
          "message": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "details"
        ],
        "title": "ApiWarning",
        "type": "object"
      },
      "ErrorCode": {
        "enum": [
          "configuration_invalid",
          "configuration_unknown_key",
          "configuration_secret_invalid",
          "secret_file_missing",
          "secret_file_outside_root",
          "secret_file_invalid_type",
          "secret_file_insecure_permissions",
          "secret_file_too_large",
          "secret_file_invalid_encoding",
          "secret_file_empty",
          "diagnostic_context_invalid",
          "diagnostic_payload_rejected",
          "internal_error",
          "database_migration_configuration_invalid",
          "database_connection_unavailable",
          "database_migration_busy",
          "database_schema_contract_invalid",
          "database_destructive_downgrade_refused",
          "object_storage_configuration_invalid",
          "object_storage_input_invalid",
          "object_storage_busy",
          "object_storage_unavailable",
          "object_storage_access_denied",
          "object_storage_contract_invalid",
          "object_storage_object_missing",
          "object_storage_integrity_failed",
          "object_storage_metadata_conflict",
          "source_publish_input_invalid",
          "source_not_found",
          "source_already_exists",
          "source_state_invalid",
          "source_version_conflict",
          "source_idempotency_mismatch",
          "source_event_identity_mismatch",
          "source_verified_receipt_stale",
          "source_content_object_conflict",
          "source_concurrency_busy",
          "source_concurrency_invariant_failed",
          "source_commit_outcome_unknown",
          "projection_dispatch_unavailable",
          "projection_intent_contract_invalid",
          "identity_bootstrap_input_invalid",
          "identity_bootstrap_state_conflict",
          "canonical_read_state_invalid",
          "canonical_recovery_environment_refused",
          "canonical_recovery_configuration_invalid",
          "canonical_recovery_snapshot_busy",
          "canonical_recovery_bundle_exists",
          "canonical_recovery_bundle_invalid",
          "canonical_recovery_target_not_empty",
          "canonical_recovery_dependency_unavailable",
          "canonical_recovery_integrity_failed",
          "canonical_recovery_restore_failed",
          "api_request_malformed",
          "api_request_validation_failed",
          "api_route_not_found",
          "api_method_not_allowed",
          "authentication_required",
          "authentication_failed",
          "authentication_rate_limited",
          "recent_authentication_required",
          "csrf_validation_failed",
          "authorization_scope_denied",
          "totp_enrollment_state_invalid",
          "device_authorization_pending",
          "device_authorization_slow_down",
          "device_authorization_denied",
          "device_authorization_expired",
          "device_authorization_state_invalid",
          "device_credential_invalid",
          "device_revoked",
          "device_token_reuse_detected",
          "plugin_version_unsupported"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "LivenessData": {
        "additionalProperties": false,
        "description": "Process-liveness success data; it implies no I/O by construction.",
        "properties": {
          "service": {
            "const": "api",
            "default": "api",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "live",
            "default": "live",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "LivenessData",
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "description": "The strict username/password login body (spec 8.2).",
        "properties": {
          "password": {
            "maxLength": 128,
            "minLength": 15,
            "title": "Password",
            "type": "string"
          },
          "username": {
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "PasswordChangeRequest": {
        "additionalProperties": false,
        "description": "The new-password body of one password change (spec 9.5).",
        "properties": {
          "new_password": {
            "maxLength": 128,
            "minLength": 15,
            "title": "New Password",
            "type": "string"
          }
        },
        "required": [
          "new_password"
        ],
        "title": "PasswordChangeRequest",
        "type": "object"
      },
      "ReadinessChecks": {
        "additionalProperties": false,
        "description": "Canonical dependency check outcomes; this child tracks PostgreSQL only.",
        "properties": {
          "postgresql": {
            "const": "ready",
            "default": "ready",
            "title": "Postgresql",
            "type": "string"
          },
          "schema": {
            "const": "ready",
            "default": "ready",
            "title": "Schema",
            "type": "string"
          }
        },
        "title": "ReadinessChecks",
        "type": "object"
      },
      "ReadinessData": {
        "additionalProperties": false,
        "description": "Readiness success data; failed readiness uses an error envelope instead.",
        "properties": {
          "checks": {
            "$ref": "#/components/schemas/ReadinessChecks"
          },
          "status": {
            "const": "ready",
            "default": "ready",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "ReadinessData",
        "type": "object"
      },
      "ReauthenticateRequest": {
        "additionalProperties": false,
        "description": "The password body of one recent re-authentication attempt (spec 9.4).\n\n``totp_code`` carries the second factor when the account holds an active\nTOTP credential: recent re-auth always verifies the password and also\nverifies TOTP when active, so a missing code fails like a wrong one.",
        "properties": {
          "password": {
            "maxLength": 128,
            "minLength": 15,
            "title": "Password",
            "type": "string"
          },
          "totp_code": {
            "anyOf": [
              {
                "pattern": "^[0-9]{6}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Totp Code"
          }
        },
        "required": [
          "password"
        ],
        "title": "ReauthenticateRequest",
        "type": "object"
      },
      "RecoveryCodesData": {
        "additionalProperties": false,
        "description": "One recovery-code revision displayed exactly once (spec 10.3).",
        "properties": {
          "codes": {
            "items": {
              "type": "string"
            },
            "title": "Codes",
            "type": "array"
          },
          "revision": {
            "title": "Revision",
            "type": "integer"
          }
        },
        "required": [
          "codes",
          "revision"
        ],
        "title": "RecoveryCodesData",
        "type": "object"
      },
      "RecoveryLimitedContext": {
        "additionalProperties": false,
        "description": "The recovery-limited binding context one accepted recovery produces.\n\nThe closed permitted-action set tells the client only TOTP replacement or\nlogout remains before normal Admin access returns (spec 10.3).",
        "properties": {
          "absolute_expires_at": {
            "format": "date-time",
            "title": "Absolute Expires At",
            "type": "string"
          },
          "idle_expires_at": {
            "format": "date-time",
            "title": "Idle Expires At",
            "type": "string"
          },
          "permitted_actions": {
            "items": {
              "enum": [
                "totp_replacement",
                "logout"
              ],
              "type": "string"
            },
            "title": "Permitted Actions",
            "type": "array"
          },
          "state": {
            "$ref": "#/components/schemas/WebSessionState"
          }
        },
        "required": [
          "state",
          "permitted_actions",
          "idle_expires_at",
          "absolute_expires_at"
        ],
        "title": "RecoveryLimitedContext",
        "type": "object"
      },
      "SessionData": {
        "additionalProperties": false,
        "description": "The public view of one Web session (spec 9.2).\n\n``state`` covers the closed session-state vocabulary including ``revoked``\n(the logout response); ``authenticated`` is true only for an ``active``\nsession, and the granted scopes stay empty in every non-active state so a\nclient learns from the login response alone whether a TOTP or recovery\nchallenge remains before any route authorizes.",
        "properties": {
          "absolute_expires_at": {
            "format": "date-time",
            "title": "Absolute Expires At",
            "type": "string"
          },
          "authenticated": {
            "title": "Authenticated",
            "type": "boolean"
          },
          "idle_expires_at": {
            "format": "date-time",
            "title": "Idle Expires At",
            "type": "string"
          },
          "scopes": {
            "items": {
              "$ref": "#/components/schemas/WebScope"
            },
            "title": "Scopes",
            "type": "array"
          },
          "state": {
            "$ref": "#/components/schemas/WebSessionState"
          }
        },
        "required": [
          "state",
          "authenticated",
          "scopes",
          "idle_expires_at",
          "absolute_expires_at"
        ],
        "title": "SessionData",
        "type": "object"
      },
      "TotpCodeRequest": {
        "additionalProperties": false,
        "description": "The six-digit code body of one TOTP challenge verification.",
        "properties": {
          "code": {
            "pattern": "^[0-9]{6}$",
            "title": "Code",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "title": "TotpCodeRequest",
        "type": "object"
      },
      "TotpEnrollmentAction": {
        "description": "The strict discriminated enrollment action vocabulary (spec 10.1).",
        "enum": [
          "start",
          "dismiss_initial_offer"
        ],
        "title": "TotpEnrollmentAction",
        "type": "string"
      },
      "TotpEnrollmentData": {
        "additionalProperties": false,
        "description": "The response payload of one enrollment action (spec 10.1).\n\n``start`` carries the one-time offer; ``dismiss_initial_offer`` carries\nonly the recorded dismissal moment — never a secret or pending row.",
        "properties": {
          "action": {
            "$ref": "#/components/schemas/TotpEnrollmentAction"
          },
          "dismissed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dismissed At"
          },
          "enrollment": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TotpEnrollmentOfferData"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "action"
        ],
        "title": "TotpEnrollmentData",
        "type": "object"
      },
      "TotpEnrollmentOfferData": {
        "additionalProperties": false,
        "description": "The one-time provisioning material of a started enrollment (10.1).\n\nThe provisioning URI and Base32 secret render exactly once, under the\nprovisioning cache-suppression headers, and never again.",
        "properties": {
          "enrollment_id": {
            "format": "uuid",
            "title": "Enrollment Id",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "provisioning_uri": {
            "title": "Provisioning Uri",
            "type": "string"
          },
          "secret": {
            "title": "Secret",
            "type": "string"
          }
        },
        "required": [
          "enrollment_id",
          "provisioning_uri",
          "secret",
          "expires_at"
        ],
        "title": "TotpEnrollmentOfferData",
        "type": "object"
      },
      "TotpEnrollmentRequest": {
        "additionalProperties": false,
        "description": "The strict discriminated enrollment action body (spec 10.1).",
        "properties": {
          "action": {
            "$ref": "#/components/schemas/TotpEnrollmentAction"
          }
        },
        "required": [
          "action"
        ],
        "title": "TotpEnrollmentRequest",
        "type": "object"
      },
      "TotpProofRequest": {
        "additionalProperties": false,
        "description": "The shared password plus current TOTP proof body (spec 10.3).",
        "properties": {
          "password": {
            "maxLength": 128,
            "minLength": 15,
            "title": "Password",
            "type": "string"
          },
          "totp_code": {
            "pattern": "^[0-9]{6}$",
            "title": "Totp Code",
            "type": "string"
          }
        },
        "required": [
          "password",
          "totp_code"
        ],
        "title": "TotpProofRequest",
        "type": "object"
      },
      "TotpRecoveryRequest": {
        "additionalProperties": false,
        "description": "The password plus one recovery code body (spec 10.3).",
        "properties": {
          "password": {
            "maxLength": 128,
            "minLength": 15,
            "title": "Password",
            "type": "string"
          },
          "recovery_code": {
            "pattern": "^[A-Za-z2-7]{4}([- ]?[A-Za-z2-7]{4}){2}$",
            "title": "Recovery Code",
            "type": "string"
          }
        },
        "required": [
          "password",
          "recovery_code"
        ],
        "title": "TotpRecoveryRequest",
        "type": "object"
      },
      "WebScope": {
        "description": "The fixed Phase 2 Web administration scopes (spec 6.1).\n\nA Web session always carries the full surface; the client never chooses,\nwidens or customizes these values.",
        "enum": [
          "web_security_manage",
          "device_authorization_approve",
          "device_administration_manage"
        ],
        "title": "WebScope",
        "type": "string"
      },
      "WebSessionState": {
        "description": "Closed Web session states (spec 9.2).",
        "enum": [
          "pending_totp",
          "active",
          "recovery_limited",
          "revoked"
        ],
        "title": "WebSessionState",
        "type": "string"
      }
    }
  },
  "info": {
    "title": "Personal Knowledge API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/auth/login": {
      "post": {
        "description": "Run one password login and issue the session and CSRF bindings.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope_SessionData_"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Login"
      }
    },
    "/api/auth/logout": {
      "post": {
        "description": "Revoke the session row, then clear both browser cookies.\n\nSpec 9.2 reaches logout from every unrevoked state — a pending or\nrecovery-limited session logs out too — so the dependency tolerates\nthose states while the CSRF triple check stays identical.",
        "operationId": "logout",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope_SessionData_"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Logout"
      }
    },
    "/api/auth/password": {
      "put": {
        "description": "Change the password, revoke other sessions and rotate this one.",
        "operationId": "changePassword",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordChangeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope_SessionData_"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Change Password"
      }
    },
    "/api/auth/reauthenticate": {
      "post": {
        "description": "Verify the password — and TOTP when active — then rotate (spec 9.4).",
        "operationId": "reauthenticate",
        "requestBody": {
          "content": {
            "application/json": {
