    "@types/mocha": "10.0.10",
    "@types/node": "24.13.3",
    "@types/sql.js": "1.4.11",
    "@vitest/coverage-v8": "4.1.10",
    "@wdio/cli": "9.31.1",
    "@wdio/local-runner": "9.31.1",
    "@wdio/mocha-framework": "9.31.1",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "mocha": "11.8.0",
    "obsidian": "1.13.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10",
    "wdio-obsidian-reporter": "3.2.0",
    "wdio-obsidian-service": "3.2.0"
